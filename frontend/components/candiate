"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/router";
import { Copy, Check, ArrowLeft, Download } from "lucide-react";
import { authAPI } from "../services/authAPI";
import Link from "next/link";

export default function CandidateDetails() {
  const router = useRouter();
  const { candidateId } = router.query;

  const [data, setData] = useState(null);
  const [copied, setCopied] = useState("");
  const [activeTab, setActiveTab] = useState("profile");

  useEffect(() => {
    if (!candidateId) return;

    const load = async () => {
      let res = await authAPI.getCandidateDetails(candidateId);
      if (res?.body && typeof res.body === "string") {
        res = JSON.parse(res.body);
      }
      setData(res);
    };

    load();
  }, [candidateId]);

  const copy = (text, key) => {
    if (!text) return;
    navigator.clipboard.writeText(text.toString());
    setCopied(key);
    setTimeout(() => setCopied(""), 1000);
  };

  if (!data) return <div className="p-6 text-white">Loading...</div>;

  const resumeUrl =
    data.resume || data.resumeUrl || data.resume_link || data.cv;

  return (
    <div className="min-h-screen bg-[var(--bg)] text-[var(--text)]">        {/* HEADER */}
        {/* HEADER */}
      <div className="flex items-center gap-4 p-5 border-b border-[var(--border)] bg-[var(--card)] sticky top-0 z-10">
        <Link href="/dashboard" className="relative group">
          <span className="btn-back hover flex items-center gap-2">
            <ArrowLeft size={16} />
            Back to Dashboard
          </span>
        </Link>
        <div>
          <h1 className="text-2xl font-semibold">
            Details of {data.first_name} {data.last_name}
          </h1>
        </div>
      </div>
     
      <div className="max-w-[1400px] mx-auto px-6 py-6 pb-10">
        {/* MAIN BOX */}
        <div className="border border-white/10 rounded-xl bg-[var(--card,#0b1220)]">

          {/* 🔥 FULL WIDTH CENTERED TABS */}
          <div className="grid grid-cols-5 border-b border-white/10">

            <Tab id="profile" label="Profile" activeTab={activeTab} setActiveTab={setActiveTab} />
            <Tab id="career" label="Career" activeTab={activeTab} setActiveTab={setActiveTab} />
            <Tab id="job" label="Job Preferences" activeTab={activeTab} setActiveTab={setActiveTab} />
            <Tab id="demo" label="Demographics" activeTab={activeTab} setActiveTab={setActiveTab} />
            <Tab id="gmail" label="Gmail" activeTab={activeTab} setActiveTab={setActiveTab} />

          </div>

          {/* CONTENT */}
          <div className="p-6 space-y-6">

            {activeTab === "profile" && (
              <>
                <Section title="Basic Info">
                  <Stack>
                    <Field label="First Name" value={data.first_name} copy={copy} copied={copied} id="fn" />
                    <Field label="Last Name" value={data.last_name} copy={copy} copied={copied} id="ln" />
                    <Field label="Email" value={data.email} copy={copy} copied={copied} id="email" />
                    <Field label="Phone" value={data.phone} copy={copy} copied={copied} id="phone" />
                    <Field label="LinkedIn" value={data.linkedin} copy={copy} copied={copied} id="linkedin" isLink />
                    <Field label="GitHub" value={data.github} copy={copy} copied={copied} id="github" isLink />
                  </Stack>
                </Section>

                <Section title="Resume">
                  {resumeUrl ? (
                    <a
                      href={resumeUrl}
                      download
                      className="inline-flex items-center gap-2 text-[var(--primary,#6366f1)] text-base"
                    >
                      <Download size={18} />
                      Download Resume
                    </a>
                  ) : (
                    <p className="text-gray-400 text-base">No resume uploaded</p>
                  )}
                </Section>

                <Section title="Address">
                  <Stack>{renderObject(data.address, copy, copied)}</Stack>
                </Section>
              </>
            )}

            {activeTab === "career" && (
              <Section title="Career Details">
                <Stack>{renderObject(data.careerDetails, copy, copied)}</Stack>
              </Section>
            )}

            {activeTab === "job" && (
              <Section title="Job Preferences">
                <Stack>{renderObject(data.jobPreferences, copy, copied)}</Stack>
              </Section>
            )}

            {activeTab === "demo" && (
              <Section title="Demographics">
                <Stack>{renderObject(data.demographic, copy, copied)}</Stack>
              </Section>
            )}

            {activeTab === "gmail" && (
              <Section title="Dedicated Gmail">
                <Stack>{renderObject(data.dedicatedGmailAccount, copy, copied)}</Stack>
              </Section>
            )}

          </div>
        </div>
      </div>
    </div>
  );
}

/* 🔥 TAB (FULL WIDTH + CENTER TEXT) */
function Tab({ id, label, activeTab, setActiveTab }) {
  const active = activeTab === id;

  return (
    <button
      onClick={() => setActiveTab(id)}
      className={`w-full py-4 text-center text-base relative ${
        active
          ? "text-[var(--primary,#6366f1)] font-semibold"
          : "text-gray-400 hover:text-white"
      }`}
    >
      {label}

      {/* ACTIVE UNDERLINE */}
      {active && (
        <div className="absolute bottom-0 left-0 right-0 h-[2px] bg-[var(--primary,#6366f1)]" />
      )}
    </button>
  );
}

/* SECTION */
function Section({ title, children }) {
  return (
    <div>
      <h2 className="text-base text-gray-400 mb-3">{title}</h2>
      {children}
    </div>
  );
}

/* STACK */
function Stack({ children }) {
  return <div className="flex flex-col gap-4">{children}</div>;
}

/* FIELD */
function Field({ label, value, copy, copied, id, isLink }) {
  return (
    <div className="flex justify-between items-start bg-white/5 border border-white/10 rounded-lg p-5">

      <div className="w-full">
        <p className="text-sm text-gray-400 mb-1">{label}</p>

        {isLink && value ? (
          <a href={value} target="_blank" className="text-lg font-medium text-[var(--primary,#6366f1)]">
            {value}
          </a>
        ) : (
          <p className="text-lg font-semibold">{value || "-"}</p>
        )}
      </div>

      <button onClick={() => copy(value, id)}>
        {copied === id ? <Check size={18} /> : <Copy size={18} />}
      </button>

    </div>
  );
}

/* OBJECT */
function renderObject(obj, copy, copied) {
  if (!obj) return null;

  return Object.entries(obj).map(([k, v]) => (
    <Field
      key={k}
      label={k}
      value={typeof v === "boolean" ? String(v) : v}
      copy={copy}
      copied={copied}
      id={k}
    />
  ));
}







